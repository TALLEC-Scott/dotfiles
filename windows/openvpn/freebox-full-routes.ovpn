# --- Full tunnel: ALL traffic goes out through the Freebox (e.g. Netflix) ---
# Ignore routes pushed by the server; set our own.
route-nopull
# Bridge mode: wait for the TAP adapter to get its DHCP lease from the Freebox.
route-delay 5 30
# Default route through the Freebox. def1 = two /1 routes (override the Wi-Fi
# default without deleting it) + a host route to the VPN server via Wi-Fi.
route-gateway 192.168.0.254
redirect-gateway def1
# DNS only through the VPN (Freebox DNS from DHCP), so Netflix picks home CDNs.
block-outside-dns
