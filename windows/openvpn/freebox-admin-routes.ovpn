# --- Split tunnel: only the Freebox admin page goes through the VPN ---
# Ignore routes pushed by the server.
route-nopull
# Bridge mode: wait for the TAP adapter to get its DHCP lease from the Freebox.
route-delay 5 30
# The Freebox DHCP gives the TAP adapter a default gateway. These two /1 routes
# via the normal (Wi-Fi) gateway are more specific, so all other traffic stays local.
route 0.0.0.0 128.0.0.0 net_gateway
route 128.0.0.0 128.0.0.0 net_gateway
# mafreebox.freebox.fr -> through the Freebox (192.168.0.254)
route 212.27.38.253 255.255.255.255 192.168.0.254
